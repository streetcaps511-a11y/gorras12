pipeline {
    agent any
    environment {
        PLAYWRIGHT_BROWSERS_PATH = 'C:\\Users\\CRISTIAN\\AppData\\Local\\ms-playwright'
    }
    stages {
        stage('Instalar dependencias') {
            steps {
                dir('frontend') {
                    bat 'npm install'
                    bat 'npx playwright install --with-deps'
                }
            }
        }
        stage('Build') {
            steps {
                dir('frontend') {
                    bat 'npm run build'
                }
            }
        }
        stage('Pruebas') {
            steps {
                dir('frontend') {
                    bat 'npx playwright test --reporter=html'
                }
            }
        }
    }
    post {
        always {
            publishHTML(target: [
                reportName: 'Playwright Report',
                reportDir: 'frontend/playwright-report',
                reportFiles: 'index.html'
            ])
        }
    }
}